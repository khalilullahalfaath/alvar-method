{
  "hooks": {
    "PreToolUse": [
      { "matcher": "Read|Grep|Glob|Write|Edit|Bash|AskUserQuestion", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs\" pre" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs\" prompt" }] }
    ],
    "SessionStart": [
      { "matcher": "clear|compact|resume|startup", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs\" start" }] }
    ]
  }
}
